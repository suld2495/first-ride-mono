+
+  private static final class WhitespaceFilter implements InputFilter {
+    @Override
+    public @Nullable CharSequence filter(
+        CharSequence source,
+        int start,
+        int end,
+        Spanned dest,
+        int dstart,
+        int dend) {
+      StringBuilder filtered = null;
+
+      for (int index = start; index < end; ) {
+        int codePoint = Character.codePointAt(source, index);
+        int characterCount = Character.charCount(codePoint);
+
+        if (Character.isWhitespace(codePoint) || Character.isSpaceChar(codePoint)) {
+          if (filtered == null) {
+            filtered = new StringBuilder(end - start);
+            filtered.append(source, start, index);
+          }
+        } else if (filtered != null) {
+          filtered.appendCodePoint(codePoint);
+        }
+
+        index += characterCount;
+      }
+
+      return filtered == null ? null : filtered.toString();
+    }
+  }
