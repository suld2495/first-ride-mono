+
+private class WhitespaceFilter : InputFilter {
+  override fun filter(
+      source: CharSequence,
+      start: Int,
+      end: Int,
+      dest: Spanned,
+      dstart: Int,
+      dend: Int,
+  ): CharSequence? {
+    var filtered: StringBuilder? = null
+    var index = start
+
+    while (index < end) {
+      val codePoint = Character.codePointAt(source, index)
+      val characterCount = Character.charCount(codePoint)
+
+      if (Character.isWhitespace(codePoint) || Character.isSpaceChar(codePoint)) {
+        if (filtered == null) {
+          filtered = StringBuilder(end - start)
+          filtered.append(source, start, index)
+        }
+      } else {
+        filtered?.appendCodePoint(codePoint)
+      }
+
+      index += characterCount
+    }
+
+    return filtered?.toString()
+  }
+}
