<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/routine_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/routine_widget_background"
  android:orientation="vertical"
  android:padding="20dp">

  <TextView
    android:id="@+id/routine_widget_title"
    android:layout_width="match_parent"
    android:layout_height="18dp"
    android:ellipsize="end"
    android:fontFamily="sans-serif"
    android:gravity="center_vertical"
    android:maxLines="1"
    android:text="이번 주 루틴"
    android:textColor="?android:attr/textColorPrimary"
    android:textSize="15sp"
    android:textStyle="bold" />

  <LinearLayout
    android:id="@+id/routine_widget_items"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="6dp"
    android:layout_weight="1"
    android:gravity="top"
    android:orientation="vertical" />

  <TextView
    android:id="@+id/routine_widget_message"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:fontFamily="sans-serif"
    android:gravity="center"
    android:text="로그인 해주세요"
    android:textColor="?android:attr/textColorSecondary"
    android:textSize="13sp"
    android:textStyle="bold" />
</LinearLayout>
